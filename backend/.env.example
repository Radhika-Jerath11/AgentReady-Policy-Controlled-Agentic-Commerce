# Database URL (Defaults to SQLite if PostgreSQL is not provided)
DATABASE_URL=sqlite:///./agentready.db
# Example PostgreSQL: postgresql://user:password@localhost:5432/agentready

# Razorpay Test Mode Credentials (Leave blank or set to 'demo' for Demo Mode)
RAZORPAY_KEY_ID=rzp_test_demo123456
RAZORPAY_KEY_SECRET=demosecret123456
RAZORPAY_WEBHOOK_SECRET=demowebhooksecret

# AI Model Configuration (Leave blank or set to 'demo' for deterministic fallback)
AI_API_KEY=
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini

# Mode
DEMO_MODE=true
